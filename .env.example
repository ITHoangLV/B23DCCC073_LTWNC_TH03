# URL của website (dùng cho metadata, openGraph và sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NextAuth secret - tạo bằng lệnh: openssl rand -base64 32 hoặc chuỗi ngẫu nhiên
AUTH_SECRET=class-deadline-hub-secret-key-change-in-production-32chars

# NextAuth production URL
AUTH_URL=http://localhost:3000

# GitHub OAuth (Tùy chọn - kích hoạt khi có cả ID & Secret)
# GITHUB_ID=
# GITHUB_SECRET=

